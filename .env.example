# Copy to .env.local and fill in.

# Postgres connection string (dev database on 5433, e2e test database on 5435)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/kynite"

# openssl rand -base64 32 — minimum 32 characters
BETTER_AUTH_SECRET=""

# Public origin; also the Google Calendar push-notification webhook base
BETTER_AUTH_URL="http://localhost:3000"

# Google Calendar sync (M05). Leave unset to run without the integration:
# linking is switched off and the settings page says which variables are missing.
# Create an OAuth client (type "Web application") in Google Cloud Console and
# add ${BETTER_AUTH_URL}/api/google/oauth/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# openssl rand -base64 32 — AES-256-GCM key for OAuth tokens at rest
TOKEN_ENCRYPTION_KEY=""

# Web push (M11). Leave unset to run without notifications: the settings panel
# says which variables are missing and no opt-in is offered.
# Generate a pair with: pnpm dlx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# RFC 8292 contact for the push service — mailto: or https:
VAPID_SUBJECT="mailto:you@example.com"

# In-process pg-boss workers; set to false for a web-only process
JOBS_ENABLED="true"
