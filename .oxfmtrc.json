{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "tabWidth": 2,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".next",
    "coverage",
    "node_modules",
    "pnpm-lock.yaml",
    "**/e2e/test-results",
    "**/e2e/playwright-report",
    "docs",
    ".claude",
    "CLAUDE.md",
    ".next-e2e-google/",
    "**/e2e/.auth/",
    "storybook-static"
  ]
}
