{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "scripts/e2e-guard.sh playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:run": "scripts/e2e-guard.sh playwright test",
    "e2e:visual": "scripts/e2e-guard.sh playwright test e2e/tests/app/visual e2e/tests/hub/visual",
    "e2e:visual:update": "scripts/e2e-guard.sh playwright test e2e/tests/app/visual e2e/tests/hub/visual --update-snapshots",
    "e2e:app": "scripts/e2e-guard.sh playwright test --project=app",
    "e2e:hub": "scripts/e2e-guard.sh playwright test --project=hub",
    "e2e:share": "scripts/e2e-guard.sh playwright test --project=share",
    "e2e:perf": "scripts/e2e-guard.sh playwright test --project=perf",
    "e2e:axe": "scripts/e2e-guard.sh playwright test axe.spec.ts",
    "e2e:setup": "docker compose -f docker-compose.test.yml up -d --wait && pnpm e2e:migrate",
    "e2e:teardown": "docker compose -f docker-compose.test.yml down -v",
    "e2e:full": "pnpm e2e:setup && { pnpm e2e:run; status=$?; pnpm e2e:teardown; exit $status; }",
    "e2e:migrate": "DATABASE_URL=${DATABASE_URL:-postgresql://kynite:kynite@localhost:5435/kynite_test} drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "ci": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm build",
    "icons:subset": "node scripts/subset-icons.mjs",
    "icons:app": "node scripts/generate-app-icons.mjs",
    "icons:check": "node scripts/check-icons.mjs",
    "prebuild": "node scripts/check-icons.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "better-auth": "1.6.26",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "next-intl": "4.13.5",
    "pg": "^8.22.0",
    "pg-boss": "^12.27.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "serwist": "9.5.12",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@serwist/turbopack": "9.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "10.8.0",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "shadcn": "4.16.2",
    "subset-font": "^2.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
