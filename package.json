{
  "name": "kynite-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=24"
  },
  "//": "Every app script below is a thin proxy onto `apps/web` so the commands documented in CLAUDE.md keep working from the repo root. `format`/`format:check` are the exception: prettier runs at the root because it also owns README.md, docs config and the workspace manifests, which no package can see.",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "//scripts-recursive": "`-r` spans the workspace (apps/web + packages/ui). `--workspace-concurrency=1` because eslint and tsc are each memory-hungry enough that running two of them at once gets the linter OOM-killed on a modest machine.",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "pnpm -r --workspace-concurrency=1 lint",
    "lint:fix": "pnpm -r --workspace-concurrency=1 lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter web test",
    "test:run": "pnpm --filter web test:run",
    "test:coverage": "pnpm --filter web test:coverage",
    "e2e": "pnpm --filter web e2e",
    "e2e:ui": "pnpm --filter web e2e:ui",
    "e2e:run": "pnpm --filter web e2e:run",
    "e2e:visual": "pnpm --filter web e2e:visual",
    "e2e:visual:update": "pnpm --filter web e2e:visual:update",
    "e2e:app": "pnpm --filter web e2e:app",
    "e2e:hub": "pnpm --filter web e2e:hub",
    "e2e:share": "pnpm --filter web e2e:share",
    "e2e:perf": "pnpm --filter web e2e:perf",
    "e2e:axe": "pnpm --filter web e2e:axe",
    "e2e:setup": "pnpm --filter web e2e:setup",
    "e2e:teardown": "pnpm --filter web e2e:teardown",
    "e2e:full": "pnpm --filter web e2e:full",
    "e2e:migrate": "pnpm --filter web e2e:migrate",
    "db:generate": "pnpm --filter web db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:push": "pnpm --filter web db:push",
    "db:studio": "pnpm --filter web db:studio",
    "db:up": "pnpm --filter web db:up",
    "db:down": "pnpm --filter web db:down",
    "storybook": "pnpm --filter @kynite/ui storybook",
    "storybook:build": "pnpm --filter @kynite/ui build-storybook",
    "icons:subset": "pnpm --filter web icons:subset",
    "icons:app": "pnpm --filter web icons:app",
    "icons:check": "pnpm --filter web icons:check",
    "ci": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm build",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "@parcel/watcher",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "//lint-staged": "Root-level files only. Files under `apps/web` are matched to that package's own `lint-staged` block (lint-staged picks the config closest to each staged file and runs it from that directory), which is where eslint.config.mjs lives.",
  "lint-staged": {
    "*.{json,md,css,yml,yaml,mjs,cjs,js}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6"
  }
}
