{
  "compilerOptions": {
    "target": "ES2022",
    // A service worker's globals live in `lib.webworker`, which collides with
    // `lib.dom` (both declare `self`, `fetch`, `caches`, …). That is why the
    // worker gets a config of its own rather than a `lib` entry in the app's:
    // the two libraries cannot coexist in one program.
    "lib": ["esnext", "webworker"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // Only the worker and the pure modules it imports. `pnpm typecheck` runs
  // this alongside the app program, so the worker is not an unchecked island.
  "include": [
    "src/app/sw.ts",
    "src/components/offline/sw-strategy.ts",
    "src/components/offline/reload-gate.ts"
  ]
}
